                                                                            <ui:InvokeCode ContinueOnError="{x:Null}" Code="// Initialize variables for tracking&#xA;int totalOccurrencesPdf1 = 0;&#xA;int totalOccurrencesPdf2 = 0;&#xA;List&lt;string&gt; duplicateStrings = new List&lt;string&gt;();&#xA;List&lt;string&gt; duplicateStrings2 = new List&lt;string&gt;();&#xA;&#xA;// Duplicate analysis for PDF1&#xA;var duplicates = in_str1_array&#xA;    .GroupBy(x =&gt; x)&#xA;    .Where(g =&gt; g.Count() &gt; 1)&#xA;    .Select(g =&gt; new { Value = g.Key, Count = g.Count() })&#xA;    .OrderByDescending(x =&gt; x.Count)&#xA;    .ToList();&#xA;&#xA;// Populate duplicate strings for PDF1&#xA;foreach (var duplicate in duplicates)&#xA;{&#xA;    duplicateStrings.Add($&quot;String: {duplicate.Value}, Occurrences: {duplicate.Count}&quot;);&#xA;    totalOccurrencesPdf1 += duplicate.Count;&#xA;}&#xA;&#xA;// Duplicate analysis for PDF2&#xA;var duplicates2 = in_str2_array&#xA;    .GroupBy(x =&gt; x)&#xA;    .Where(g =&gt; g.Count() &gt; 1)&#xA;    .Select(g =&gt; new { Value = g.Key, Count = g.Count() })&#xA;    .OrderByDescending(x =&gt; x.Count)&#xA;    .ToList();&#xA;&#xA;// Populate duplicate strings for PDF2&#xA;foreach (var duplicate2 in duplicates2)&#xA;{&#xA;    duplicateStrings2.Add($&quot;String: {duplicate2.Value}, Occurrences: {duplicate2.Count}&quot;);&#xA;    totalOccurrencesPdf2 += duplicate2.Count;&#xA;}&#xA;&#xA;// Comprehensive comparison&#xA;bool isDifferent = false;&#xA;&#xA;// Detailed comparison report&#xA;Console.WriteLine(&quot;Duplicate Analysis Comparison:&quot;);&#xA;Console.WriteLine(&quot;-----------------------------&quot;);&#xA;&#xA;// Total occurrences comparison&#xA;if (totalOccurrencesPdf1 != totalOccurrencesPdf2)&#xA;{&#xA;    isDifferent = true;&#xA;    Console.WriteLine($&quot;Total Duplicate Occurrences Mismatch!&quot;);&#xA;    Console.WriteLine($&quot;PDF1 Total Duplicate Occurrences: {totalOccurrencesPdf1}&quot;);&#xA;    Console.WriteLine($&quot;PDF2 Total Duplicate Occurrences: {totalOccurrencesPdf2}&quot;);&#xA;}&#xA;&#xA;// Strings present in PDF1 but not in PDF2&#xA;var pdf1OnlyDuplicates = duplicates&#xA;    .Where(d1 =&gt; duplicates2.All(d2 =&gt; d2.Value != d1.Value))&#xA;    .ToList();&#xA;if (pdf1OnlyDuplicates.Any())&#xA;{&#xA;    isDifferent = true;&#xA;    Console.WriteLine(&quot;\nStrings Duplicated in PDF1 but Not in PDF2:&quot;);&#xA;    foreach (var uniqueDuplicate in pdf1OnlyDuplicates)&#xA;    {&#xA;        Console.WriteLine($&quot;String: {uniqueDuplicate.Value}, Occurrences: {uniqueDuplicate.Count}&quot;);&#xA;        uniqueDuplicate_control = uniqueDuplicate.Value;&#xA;    }&#xA;}&#xA;&#xA;// Strings present in PDF2 but not in PDF1&#xA;var pdf2OnlyDuplicates = duplicates2&#xA;    .Where(d2 =&gt; duplicates.All(d1 =&gt; d1.Value != d2.Value))&#xA;    .ToList();&#xA;if (pdf2OnlyDuplicates.Any())&#xA;{&#xA;    isDifferent = true;&#xA;    Console.WriteLine(&quot;\nStrings Duplicated in PDF2 but Not in PDF1:&quot;);&#xA;    foreach (var uniqueDuplicate in pdf2OnlyDuplicates)&#xA;    {&#xA;        Console.WriteLine($&quot;String: {uniqueDuplicate.Value}, Occurrences: {uniqueDuplicate.Count}&quot;);&#xA;        uniqueDuplicate_test= uniqueDuplicate.Value;&#xA;    }&#xA;}&#xA;&#xA;// Strings with different occurrence counts&#xA;var differentOccurrences = duplicates&#xA;    .Join(duplicates2, &#xA;        d1 =&gt; d1.Value, &#xA;        d2 =&gt; d2.Value, &#xA;        (d1, d2) =&gt; new { Value = d1.Value, Pdf1Count = d1.Count, Pdf2Count = d2.Count })&#xA;    .Where(x =&gt; x.Pdf1Count != x.Pdf2Count)&#xA;    .ToList();&#xA;if (differentOccurrences.Any())&#xA;{&#xA;    isDifferent = true;&#xA;    Console.WriteLine(&quot;\nStrings with Different Occurrence Counts:&quot;);&#xA;    foreach (var diffOccurrence in differentOccurrences)&#xA;    {&#xA;        Console.WriteLine($&quot;String: {diffOccurrence.Value}, &quot; +&#xA;                         $&quot;PDF1 Occurrences: {diffOccurrence.Pdf1Count}, &quot; +&#xA;                         $&quot;PDF2 Occurrences: {diffOccurrence.Pdf2Count}&quot;);&#xA;        uniqueDuplicate_control = diffOccurrence.Value;  // Using control for PDF1&#xA;        uniqueDuplicate_test = diffOccurrence.Value;     // Using test for PDF2&#xA;    }&#xA;}&#xA;&#xA;// Final summary&#xA;if (!isDifferent)&#xA;{&#xA;    Console.WriteLine(&quot;No differences found in duplicate strings between PDFs.&quot;);&#xA;}&#xA;else&#xA;{&#xA;    Console.WriteLine(&quot;\nDuplicate Analysis Complete: Differences Detected.&quot;);&#xA;}" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="545.6,196.8" sap2010:WorkflowViewState.IdRef="InvokeCode_46" Language="CSharp">
